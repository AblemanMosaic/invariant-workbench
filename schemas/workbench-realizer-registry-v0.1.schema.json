{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:miw:workbench-realizer-registry:v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","registry_id","dictionary_root","authority_effect","standing","status_algebra","profiles","nonclaims"],
  "properties":{
    "schema":{"const":"miw.workbench-realizer-registry.v0.1"},
